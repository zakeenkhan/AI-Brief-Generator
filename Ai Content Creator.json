        "jsCode": "// Ensure we handle incoming data from the Google Sheets node safely\nconst rows = $input.all();\n\n// Wrap the array inside a single history object for Brief Studio\nreturn [\n  {\n    json: {\n      history: rows.map(item => {\n        return {\n          // Replace 'Topic' with your exact Google Sheets column header\n          topic: item.json.Topic || \"Untitled Generation\", \n          \n          // Replace 'GeneratedContent' with your exact column header\n          content: item.json.GeneratedContent || \"\",       \n          \n          // Replace 'Date' with your exact column header or leave fallback\n          date: item.json.Date || new Date().toISOString()\n        };\n      })\n    }\n  }\n];"
      },
